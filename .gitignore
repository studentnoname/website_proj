# ============================================================================
# HugoBlox Kit - Monorepo .gitignore
# ============================================================================

# ============================================================================
# Local Agent Files
# ============================================================================

AGENTS.local*.md
CLAUDE.local*.md
.claude/settings.json

# ============================================================================
# Build Artifacts & Generated Files
# ============================================================================

# Hugo build artifacts
public/
resources/
.hugo_build.lock
hugo_stats.json

# Go modules
go.sum

# Node.js
node_modules/

# Pagefind search index (generated at build time)
**/pagefind/

# JSConfig files (auto-generated by Hugo)
**/assets/jsconfig.json

# pnpm lock files in starters (keep template clean)
starters/**/pnpm-lock.yaml

# ============================================================================
# Development Environment
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local

# IDE & Editor files
.idea/
/.vscode/
.specstory/
/docs/

# ============================================================================
# Language & Framework Specific
# ============================================================================

# Python (for scripts)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.venv/

# Jupyter Notebooks
.ipynb_checkpoints/

# ============================================================================
# Operating System
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.nfs*

# ============================================================================
# Logs & Temporary Files
# ============================================================================

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Temporary directories
tmp/
temp/
.tmp/
backups/

# Prepared Hugo Pages site
!/site/
!/site/**
!/.github/
!/.github/**
!/.github-pages.json
/public/
/.pages-tools/
**/node_modules/
**/resources/_gen/
**/.hugo_build.lock
/.github-pages-setup-backups/

# Workstation tools, original handoff inputs and private submission material
/.local/
/codex_handoff/
/submission/
/.claude/
/AGENTS.local.md
**/hugo_stats.json
**/.DS_Store

# Assignment evidence is source material, not generated upstream documentation
!/docs/
!/docs/**
